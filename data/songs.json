    "sections": [
      {
        "name": "主歌",
        "lines": [
          {"chords": ["C", "Am", "Dm", "G7"], "lyric": "你问我爱你有多深 我爱你有几分"},
          {"chords": ["C", "Am", "Dm", "G7"], "lyric": "我的情也真 我的爱也真 月亮代表我的心"},
          {"chords": ["C", "G", "Am", "Em"], "lyric": "轻轻的一个吻 已经打动我的心"},
          {"chords": ["F", "C", "G", "C"], "lyric": "深深的一段情 教我思念到如今"}
        ]
      },
      {
        "name": "副歌",
        "lines": [
          {"chords": ["C", "Am", "F", "G"], "lyric": "问问世界上 什么是永恒 有什么比爱更动人"},
          {"chords": ["C", "Am", "Dm", "G7", "C"], "lyric": "月亮代表我的心 轻轻告诉你 我的爱不变"}
        ]
      }
    ]
  },
