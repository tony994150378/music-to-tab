        "lines": [
          {"chords": ["Em", "D", "C", "G"], "lyric": "我曾经跨过山和大海 也穿过人山人海"},
          {"chords": ["Am", "Em", "D", "C"], "lyric": "我曾经拥有着的一切 转眼都飘散如烟"},
          {"chords": ["Em", "D", "C", "G"], "lyric": "我曾经失落失望失掉所有方向 直到看见平凡才是"},
          {"chords": ["Am", "Em", "D", "G"], "lyric": "唯一的答案"}
        ]
      }
    ]
  },
